@base = http://127.0.0.1:5000/api/requests

### Все студенты
GET {{base}}

### Фильтр: группа и общежитие
GET {{base}}?group=M3301&dormitory=8

### Фильтр, под который никто не подходит (200 и пустой список)
GET {{base}}?group=Z3999

### Неизвестный фильтр (400)
GET {{base}}?dorm=8

### Один студент
GET {{base}}/1

### Студента нет (404)
GET {{base}}/999

### Добавить студента (201)
POST {{base}}
Content-Type: application/json

{"name": "Кузнецов Павел", "group": "M3302", "isu": "411111", "dormitory": 6, "room": "803", "term": "2026-09-01", "international": false, "note": ""}

### Тот же ИСУ ещё раз (409)
POST {{base}}
Content-Type: application/json

{"name": "Другой Человек", "group": "M3302", "isu": "411111", "dormitory": 6, "room": "803", "term": "2026-09-01", "international": false}

### Неправильные поля: ИСУ с нуля и группа с 5 (422)
POST {{base}}
Content-Type: application/json

{"name": "Кузнецов Павел", "group": "M5302", "isu": "011111", "dormitory": 6, "room": "803", "term": "2026-09-01", "international": false}

### Сломанный JSON (400)
POST {{base}}
Content-Type: application/json

{"name": "Кузнецов Павел"

### Изменить ИСУ студента 1
PATCH {{base}}/1
Content-Type: application/json

{"isu": "412346"}

### Метода PUT нет (405)
PUT {{base}}/1
Content-Type: application/json

{}

### Удалить студента (204, повтор — 404)
DELETE {{base}}/10

# QUERY расширение REST Client не поддерживает, его проверяем из консоли браузера:
# await fetch("/api/requests", {method: "QUERY", headers: {"Content-Type": "application/json"},
#   body: JSON.stringify({dormitory: "8", international: "true", term_from: "2025-01-01", term_to: "2025-12-31"})})
