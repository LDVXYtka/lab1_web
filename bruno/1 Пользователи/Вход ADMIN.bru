meta {
  name: Вход ADMIN
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getHeader("set-cookie").join(";")).to.include("HttpOnly");
  });
}
