meta {
  name: CSRF
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/api/auth/csrf
  body: none
  auth: none
}

script:post-response {
  bru.setVar("csrfToken", res.body.token);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.headerName).to.equal("X-XSRF-TOKEN");
  });
}
