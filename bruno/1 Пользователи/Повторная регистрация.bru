meta {
  name: Повторная регистрация
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{userUsername}}",
    "email": "{{userUsername}}@itmo.ru",
    "password": "{{userPassword}}",
    "role": "USER"
  }
}

tests {
  test("409, имя и почта заняты", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.body.fields).to.have.keys("username", "email");
  });
}
