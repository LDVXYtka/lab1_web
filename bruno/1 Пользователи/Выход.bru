meta {
  name: Выход
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  const cookies = await bru.cookies.jar().getCookies(bru.getEnvVar("baseUrl") + "/api/auth");
  bru.setVar("loggedOutRefresh", cookies.find(cookie => cookie.key === "lab5RefreshToken").value);
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getHeader("set-cookie").join(";")).to.include("Max-Age=0");
  });
}
