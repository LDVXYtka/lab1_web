meta {
  name: Обновление токена
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  const jar = bru.cookies.jar();
  const cookie = await jar.getCookie(bru.getEnvVar("baseUrl") + "/api/auth", "refreshToken");
  bru.setVar("oldUserRefresh", cookie.value);
}

script:post-response {
  const cookies = res.getHeader("set-cookie");
  const refresh = cookies.find(value => value.startsWith("refreshToken="));
  bru.setVar("newUserRefresh", refresh.split(";")[0].slice("refreshToken=".length));
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
    expect(bru.getVar("newUserRefresh")).to.not.equal(bru.getVar("oldUserRefresh"));
  });
}
