meta {
  name: Вход с неверным паролем
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "username": "{{userUsername}}",
    "password": "{{wrongPassword}}"
  }
}

script:pre-request {
  const password = bru.getEnvVar("userPassword");
  bru.setVar("wrongPassword", password.startsWith("a") ? "bbbbbbbb" : "aaaaaaaa");
}

tests {
  test("401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
