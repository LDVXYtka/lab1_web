meta {
  name: Refresh после выхода
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  await bru.cookies.jar().setCookie(bru.getEnvVar("baseUrl"), {
    key: "lab5RefreshToken",
    value: bru.getVar("loggedOutRefresh"),
    path: "/",
    httpOnly: true,
    sameSite: "lax"
  });
}

script:post-response {
  await bru.cookies.jar().deleteCookie(bru.getEnvVar("baseUrl") + "/api/auth", "lab5RefreshToken");
}

tests {
  test("HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
