meta {
  name: Регистрация
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "username": "{{userUsername}}",
    "email": "{{userUsername}}@itmo.ru",
    "password": "{{userPassword}}"
  }
}

script:pre-request {
  bru.setVar("userUsername", "user" + Date.now());
}

tests {
  test("201 без тела", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
