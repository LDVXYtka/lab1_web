meta {
  name: Регистрация
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{userUsername}}",
    "email": "{{userUsername}}@itmo.ru",
    "password": "{{userPassword}}"
  }
}

script:pre-request {
  bru.setVar("userUsername", "user" + Date.now());
}

tests {
  test("201, роль USER", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.role).to.equal("USER");
  });
}
