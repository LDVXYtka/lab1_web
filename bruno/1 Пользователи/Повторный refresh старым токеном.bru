meta {
  name: Повторный refresh старым токеном
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  const jar = bru.cookies.jar();
  await jar.setCookie(bru.getEnvVar("baseUrl"), {
    key: "refreshToken",
    value: bru.getVar("oldUserRefresh"),
    path: "/api/auth",
    httpOnly: true,
    sameSite: "lax"
  });
}

script:post-response {
  const jar = bru.cookies.jar();
  await jar.setCookie(bru.getEnvVar("baseUrl"), {
    key: "refreshToken",
    value: bru.getVar("newUserRefresh"),
    path: "/api/auth",
    httpOnly: true,
    sameSite: "lax"
  });
}

tests {
  test("HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
