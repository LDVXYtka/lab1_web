meta {
  name: Регистрация с ошибками
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "a",
    "email": "not-an-email",
    "password": "short",
    "role": "BOSS"
  }
}

tests {
  test("422 и ошибки по полям", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.fields).to.have.keys("username", "email", "password", "role");
  });
}
