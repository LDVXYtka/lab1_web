meta {
  name: Список с пагинацией и сортировкой
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/requests?page=1&size=5&sort=name&order=asc
  body: none
  auth: bearer
}

params:query {
  page: 1
  size: 5
  sort: name
  order: asc
}

auth:bearer {
  token: {{adminAccess}}
}

tests {
  test("200, не больше 5 записей и общее число", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items.length).to.be.at.most(5);
    expect(res.body.total).to.be.a("number");
  });
}
