meta {
  name: Фильтр ID и заметок
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/requests?id={{studentId}}&note=Bruno
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.total).to.equal(1);
    expect(res.body.items[0].id).to.equal(bru.getVar("studentId"));
  });
}
