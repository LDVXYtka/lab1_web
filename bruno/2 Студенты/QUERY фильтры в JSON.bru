meta {
  name: QUERY фильтры в JSON
  type: http
  seq: 7
}

http {
  method: QUERY
  url: {{baseUrl}}/api/requests
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "id": {{studentId}},
    "name": "Тестов",
    "group": "P3220",
    "dormitory": 3,
    "note": "Bruno"
  }
}

tests {
  test("QUERY возвращает созданного студента", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.total).to.equal(1);
    expect(res.body.items[0].id).to.equal(bru.getVar("studentId"));
  });
}
