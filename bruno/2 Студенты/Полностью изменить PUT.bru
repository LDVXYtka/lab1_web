meta {
  name: Полностью изменить PUT
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/requests/{{studentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccess}}
}

body:json {
  {
    "name": "Тестов Тест Тестович",
    "group": "M3301",
    "isu": "{{newIsu}}",
    "dormitory": 8,
    "room": "1501",
    "term": "2025-09-01",
    "international": true
  }
}

tests {
  test("200, все поля заменены, note стала пустой", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.group).to.equal("M3301");
    expect(res.body.note).to.equal("");
  });
}
