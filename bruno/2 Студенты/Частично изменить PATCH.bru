meta {
  name: Частично изменить PATCH
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/requests/{{studentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccess}}
}

body:json {
  {
    "room": "1002"
  }
}

tests {
  test("200, поменялась только комната", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.room).to.equal("1002");
    expect(res.body.group).to.equal("M3301");
  });
}
