meta {
  name: Создать с занятым ИСУ
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccess}}
}

body:json {
  {
    "name": "Другой Студент",
    "group": "P3220",
    "isu": "{{newIsu}}",
    "dormitory": 3,
    "room": "1204",
    "term": "2026-09-01",
    "international": false
  }
}

tests {
  test("409, ИСУ занят", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.body.fields).to.have.key("isu");
  });
}
